rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().accountType == role &&
         getUserData().accountStatus == 'active')
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isUnderwriter() {
      return hasRole('underwriter') || isAdmin();
    }

    function isOperator() {
      return hasRole('operator') || isAdmin();
    }

    function isStaff() {
      return hasRole('staff') || isUnderwriter() || isAdmin();
    }

    // --- USERS & AUTH ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.accountType == 'customer' &&
                       request.resource.data.accountStatus == 'active';
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        request.resource.data.accountType == resource.data.accountType &&
                        request.resource.data.accountStatus == resource.data.accountStatus);
      allow delete: if false; // Soft-delete / deactivate only
    }

    // --- CUSTOMERS ---
    match /customers/{customerId} {
      allow read: if isOwner(customerId) ||
                   (resource != null && (
                     isOwner(resource.data.authUid) ||
                     (isOperator() && resource.data.createdByOperatorId == request.auth.uid)
                   )) ||
                   isStaff();
      allow create: if (isAuthenticated() && (customerId == request.auth.uid || request.auth.uid == request.resource.data.authUid)) || isOperator();
      allow update: if isOwner(customerId) ||
                    isOwner(resource.data.authUid) ||
                    (isOperator() && resource.data.createdByOperatorId == request.auth.uid) ||
                    isStaff();
      allow delete: if false;
    }

    // --- OPERATORS ---
    match /operators/{operatorId} {
      allow read: if isOwner(operatorId) || isStaff();
      allow write: if isAdmin();
    }

    // --- STAFF ---
    match /staff/{staffId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // --- BRANCHES ---
    match /branches/{branchId} {
      allow read: if true; // Public branch directory
      allow write: if isAdmin();
    }

    // --- PRODUCTS & CMS ---
    match /products/{productId} {
      // Public can only view published and active products
      allow read: if resource.data.publicStatus == 'published' || isStaff();
      allow create, update: if isAdmin() || (hasRole('underwriter') && request.resource.data.publicStatus != 'published');
      allow delete: if false; // Products must be archived, not deleted
    }

    match /productVersions/{versionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // --- APPLICATIONS ---
    match /applications/{applicationId} {
      allow read: if isOwner(resource.data.customerId) || 
                   (isOperator() && resource.data.createdByOperatorId == request.auth.uid) ||
                   isStaff();
      allow create: if isAuthenticated() &&
                       (request.resource.data.customerId == request.auth.uid || isOperator());
      allow update: if (isOwner(resource.data.customerId) && resource.data.applicationStatus in ['draft', 'more_info_required', 'submitted', 'quoted'])
                    || (isOperator() && resource.data.createdByOperatorId == request.auth.uid)
                    || isStaff();
      allow delete: if false;
    }

    // --- DOCUMENTS (Metadata) ---
    match /documents/{documentId} {
      allow read: if isOwner(resource.data.ownerCustomerId) || isStaff();
      allow create: if isAuthenticated() &&
                       (request.resource.data.ownerCustomerId == request.auth.uid || isStaff());
      allow update: if isOwner(resource.data.ownerCustomerId) || isStaff();
      allow delete: if false;
    }

    // --- QUOTATIONS ---
    match /quotations/{quotationId} {
      allow read: if isOwner(resource.data.customerId) || isStaff();
      allow create: if isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isUnderwriter());
      allow update, delete: if isUnderwriter();
    }

    // --- PAYMENT ATTEMPTS ---
    match /paymentAttempts/{attemptId} {
      allow read: if isOwner(resource.data.customerId) || isStaff();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if false;
    }

    // --- POLICIES (Authoritative Registry) ---
    match /policies/{policyId} {
      allow read: if isOwner(resource.data.customerId) || isStaff();
      allow create: if isUnderwriter() || (isAuthenticated() && request.resource.data.customerId == request.auth.uid);
      allow update, delete: if isUnderwriter();
    }

    // --- PUBLIC POLICY VERIFICATION INDEX (Non-PII lookup by verificationCode) ---
    match /policyVerifications/{verificationCode} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isUnderwriter();
    }

    // --- PUBLIC POLICY VERIFICATION LOGS ---
    match /policyVerificationLogs/{logId} {
      allow read: if isStaff();
      allow create: if true; // Public verification service appends verification attempts
      allow update, delete: if false; // Immutable audit log
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false; // Strictly append-only
    }

    // --- EMAIL JOBS & TEMPLATES ---
    match /emailTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /emailJobs/{jobId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // --- TRAINING ---
    match /trainingCourses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /trainingProgress/{progressId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow write: if isOwner(request.resource.data.userId) || isAdmin();
    }

    // --- CLAIMS ---
    match /claims/{claimId} {
      allow read: if isOwner(resource.data.customerId) || isStaff();
      allow create: if isAuthenticated() &&
                       (request.resource.data.customerId == request.auth.uid || isStaff());
      allow update: if isStaff();
      allow delete: if false;
    }

    // --- SECURITY EVENTS ---
    match /securityEvents/{eventId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // Strictly append-only security log
    }
  }
}
